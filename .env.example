# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# omdbapi.com free API key. Used at build time only (server-side), never sent to the browser.
# If unset, ratings are simply not shown — no placeholder, per the PRD.
OMDB_API_KEY=

# themoviedb.org (TMDB) API key (v3 auth). Used at build time only to fetch a
# properly-licensed still/backdrop image per movie, with on-page attribution.
# If unset, falls back to the local image in public/images/stills instead.
TMDB_API_KEY=

# formspree.io form endpoint, e.g. https://formspree.io/f/xxxxxxxx
# Must be prefixed NEXT_PUBLIC_ because the contact form submits directly from the browser.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
